#define RED    0x10
#define WHITE  0x70

/* Defined in game.c */
extern unsigned char lives[4];
extern unsigned char boats_left;

unsigned char bars[4] = {0x00, 0x08, 0x48, 0x49};  // for horizontal bars //
unsigned char leds[5] = {0x00, 0x01, 0x03, 0x07, 0x0F}; //LED for boats remaining //
unsigned char digit_on[4] = {0xFE, 0xFD, 0xFB, 0xF7};

unsigned char digit = 0;

void feedback_init(void)
{
    DDRB = 0xFF;
    DDRJ |= 0x02;

    PWME = 0x00;
    DDRP |= 0x7F;
    PTP = 0x0F;

    DDRM |= 0x04;
    PTM &= 0xFB;

    DDRT |= 0x20;
    PTT &= 0xDF;
}
