
/* Press a column (1-8) then a row (1-8) on the keypad. Press # for a new game.
 * Hidden boats (column, row):
 *   Boat 1: (1,1) (2,1)        Boat 2: (8,7) (8,8)
 *   Boat 3: (3,4) (4,4) (5,4)  Boat 4: (6,1) (6,2) (6,3)
 */
#include <hidef.h>
#include "derivative.h"

#define RS_PIN   0x01     // LCD on PT0-PT2 //
#define RW_PIN   0x02
#define E_PIN    0x04

#define LINE1  0x84       // LCD text lines on the right side //
#define LINE2  0x94
#define LINE3  0x8C
#define LINE4  0x9C

#define RED    0x10       // RGB LED: PP4 //
#define WHITE  0x70       // PP4 + PP5 + PP6 //

unsigned char ships[8][8];    /* 0 = water, 1-4 = boat number */
unsigned char shots[8][8];    /* 0 = not fired, 1 = miss, 2 = hit */
unsigned char lives[4];       /* lives left for each boat */
unsigned char boats_left;     /* boats still afloat */

unsigned char bars[4] = {0x00, 0x08, 0x48, 0x49};        /* 0, 1, 2, 3 horizontal bars */
unsigned char leds[5] = {0x00, 0x01, 0x03, 0x07, 0x0F};  /* 0 to 4 LEDs on */
unsigned char digit_on[4] = {0xFE, 0xFD, 0xFB, 0xF7};    /* turn on digit 1, 2, 3, 4 */
unsigned char digit = 0;      /* what show_display lights next: 0 = LEDs, 1-4 = digits */

void show_display(void);     /* in the FEEDBACK section below */

char keys[16] = {'1','4','7','*', '2','5','8','0', '3','6','9','#', 'A','B','C','D'};

void short_delay(void) {
    int i;
    for (i = 0; i < 10; i++);
}

void delay_ms(int ms) {
    int i, j;
    for (i = 0; i < ms; i++) {
        for (j = 0; j < 4000; j++);
    }
}

void send_Byte(unsigned char b) {
    int i;
    for (i = 0; i < 8; i++) {
        if (b & 0x80) PTT |= RW_PIN;
        else          PTT &= 0xFD;
        short_delay();
        PTT |= E_PIN;
        short_delay();
        PTT &= 0xFB;
        b = b << 1;
    }
}

void send_cmd(unsigned char c) {
    PTT |= RS_PIN;
    send_Byte(0xF8);
    send_Byte(c & 0xF0);
    send_Byte((c << 4) & 0xF0);
    PTT &= 0xFE;
    show_display();       /* keep the 7-seg lit while the LCD is busy */
    delay_ms(1);
}

void send_data(unsigned char d) {
    PTT |= RS_PIN;
    send_Byte(0xFA);
    send_Byte(d & 0xF0);
    send_Byte((d << 4) & 0xF0);
    PTT &= 0xFE;
    show_display();       /* keep the 7-seg lit while the LCD is busy */
    delay_ms(1);
}

/* Write text at an address (right side: LINE1 - LINE4) */
void lcd_string(unsigned char addr, char *s) {
    send_cmd(addr);
    while (*s) {
        send_data(*s);
        s++;
    }
}

void lcd_init(void) {
    int y, x;

    DDRT |= RS_PIN | RW_PIN | E_PIN;
    PTT &= 0xF8;

    delay_ms(50);
    send_cmd(0x30);
    send_cmd(0x30);
    send_cmd(0x0C);
    send_cmd(0x01);        // clear text //
    delay_ms(12);
    send_cmd(0x06);

    send_cmd(0x34);        /* clear all pixels */
    for (y = 0; y < 32; y++) {
        send_cmd(0x80 + y);
        send_cmd(0x80);
        for (x = 0; x < 32; x++) send_data(0x00);
    }
    send_cmd(0x30);
}

// Draw the 8x8 grid: filled square = hit, small dot = miss (boats not shown) //
void draw_grid(void) {
    int y, col;
    unsigned char pixels;

    send_cmd(0x36);                          // graphics mode //

    for (y = 0; y < 64; y++) {
        if (y < 32) {                        // top half //
            send_cmd(0x80 + y);
            send_cmd(0x80);
        } else {                             /* bottom half */
            send_cmd(0x80 + (y - 32));
            send_cmd(0x88);
        }

        for (col = 0; col < 8; col++) {
            if (y % 8 == 0 || y == 63) {
                pixels = 0xFF;               /* horizontal line */
            } else {
                pixels = 0x80;               /* left edge */
                if (col == 7) pixels |= 0x01;                 /* right edge */
                if (shots[y / 8][col] == 2 && y % 8 >= 2 && y % 8 <= 5)
                    pixels |= 0x3C;          /* hit: filled square */
                if (shots[y / 8][col] == 1 && (y % 8 == 3 || y % 8 == 4))
                    pixels |= 0x18;          /* miss: small dot */
            }
            send_data(pixels);
        }
    }

    send_cmd(0x30);                          /* back to text mode */
}

void feedback_init(void) {
    DDRB = 0xFF;          /* LEDs / 7-seg segments */
    DDRJ |= 0x02;         /* LED enable (PJ1) */
    PWME = 0x00;          /* Port P as normal pins */
    DDRP |= 0x7F;         /* PP0-PP3 digits, PP4-PP6 RGB */
    PTP = 0x0F;           /* digits off, RGB off */
    DDRM |= 0x04;         /* RGB enable (PM2) */
    PTM &= 0xFB;
    DDRT |= 0x20;         /* speaker (PT5) */
    PTT &= 0xDF;
}

/* Lights ONE thing each call: the LEDs, or one 7-seg digit.
   wait() calls it every 0.25 ms so all 4 digits look lit, no flicker. */
void show_display(void) {
    PTP |= 0x0F;          /* all digits off */
    PTJ |= 0x02;          /* LEDs off */

    if (digit == 0) {
        PORTB = leds[boats_left];         /* one LED per boat afloat */
        PTJ &= 0xFD;
    } else {
        PORTB = bars[lives[digit - 1]];   /* bars = that boat's lives */
        PTP &= digit_on[digit - 1];
    }

    digit++;
    if (digit > 4) digit = 0;
}

/* Wait 'ms' milliseconds, but keep the 7-seg and LEDs lit.
   Use this instead of delay_ms everywhere the display must stay on. */
void wait(unsigned int ms) {
    int i, j;

    while (ms > 0) {
        for (i = 0; i < 4; i++) {         /* 4 steps of 0.25 ms */
            show_display();
            for (j = 0; j < 1000; j++);
        }
        ms--;
    }
}

void rgb(unsigned char color) {
    PTP &= 0x8F;          /* RGB off */
    PTP |= color;         /* chosen color on */
}

/* Beep 'times' times, each 'length' ms long, 'gap' ms apart */
void beep(unsigned char times, unsigned int length, unsigned int gap) {
    unsigned char t;
    unsigned int i;

    for (t = 0; t < times; t++) {
        for (i = 0; i < length; i++) {
            PTT ^= 0x20;              /* toggle speaker every 1 ms = tone */
            wait(1);
        }
        PTT &= 0xDF;                  /* speaker off */
        if (t < times - 1) wait(gap); /* pause only BETWEEN beeps */
    }
}

void feedback_miss(void) {            /* white, 1 beep  (about 0.15 s) */
    rgb(WHITE);
    beep(1, 150, 0);
    rgb(0);
}

void feedback_hit(void) {             /* red, 3 beeps  (about 0.4 s) */
    rgb(RED);
    beep(3, 80, 80);
    rgb(0);
}

void feedback_sink(void) {            /* red blinks 3 times  (about 1.2 s) */
    unsigned char i;

    for (i = 0; i < 3; i++) {
        rgb(RED);
        beep(1, 250, 0);
        rgb(0);
        wait(50);
    }
}

void feedback_gameover(void) {        /* red stays on, long beep */
    rgb(RED);
    beep(1, 600, 0);
}

/* Returns the key pressed right now, or 0 if none */
char read_key(void) {
    unsigned char row, col, i;
    unsigned char drive[4] = {0xFE, 0xFD, 0xFB, 0xF7};

    for (row = 0; row < 4; row++) {
        PORTA = drive[row];                  /* one row low */
        for (i = 0; i < 10; i++);            /* let it settle */
        for (col = 0; col < 4; col++) {
            if ((PORTA & (0x10 << col)) == 0) {
                return keys[row * 4 + col];
            }
        }
    }
    return 0;
}

/* Wait for a key press and release */
char get_key(void) {
    char k;

    do {
        k = read_key();
        if (k == 0) wait(1);                 /* keep 7-seg and LEDs lit, 1 ms each */
    } while (k == 0);
    wait(20);                                /* debounce */
    while (read_key() != 0) wait(1);         /* wait for release */
    wait(20);
    return k;
}

/* Wait for 1-8. Returns 1-8, or 0 if # was pressed */
unsigned char get_number(void) {
    char k;

    for (;;) {
        k = get_key();
        if (k >= '1' && k <= '8') return (unsigned char)(k - '0');
        if (k == '#') return 0;
    }
}

/* SETUP: hidden boats in fixed places, empty grid */
void new_game(void) {
    unsigned char r, c;

    for (r = 0; r < 8; r++) {
        for (c = 0; c < 8; c++) {
            ships[r][c] = 0;
            shots[r][c] = 0;
        }
    }

    /* place the hidden boats: ships[row-1][column-1] */
    ships[0][0] = 1;  ships[0][1] = 1;                     /* boat 1 */
    ships[6][7] = 2;  ships[7][7] = 2;                     /* boat 2 */
    ships[3][2] = 3;  ships[3][3] = 3;  ships[3][4] = 3;   /* boat 3 */
    ships[0][5] = 4;  ships[1][5] = 4;  ships[2][5] = 4;   /* boat 4 */

    lives[0] = 2;  lives[1] = 2;  lives[2] = 3;  lives[3] = 3;
    boats_left = 4;

    rgb(0);
    draw_grid();
    lcd_string(LINE1, "C:  R:  ");      /* top: target */
    lcd_string(LINE2, "        ");      /* under it: hit / miss */
    lcd_string(LINE3, "        ");
    lcd_string(LINE4, "ATTACK! ");      /* bottom: state of the game */
}

void main(void) {
    unsigned char col, row, boat;
    char target[9] = "C:  R:  ";

    /* ---- POWER ON: initialize components ---- */
    lcd_init();
    feedback_init();
    DDRA = 0x0F;          /* keypad: PA0-PA3 rows out, PA4-PA7 columns in */
    PUCR |= 0x01;         /* pull-ups on Port A */

    /* ---- SETUP ---- */
    new_game();

    for (;;) {
        /* ATTACK: pick the target on the keypad */
        col = get_number();
        if (col == 0) { new_game(); continue; }
        target[2] = '0' + col;
        target[6] = ' ';
        lcd_string(LINE1, target);                 /* show column right away */
        lcd_string(LINE2, "        ");             /* clear last result */

        row = get_number();
        if (row == 0) { new_game(); continue; }
        target[6] = '0' + row;
        lcd_string(LINE1, target);                 /* show row */

        /* already fired here? */
        if (shots[row - 1][col - 1] != 0) {
            lcd_string(LINE2, "TAKEN   ");
            continue;
        }

        /*read location against ship map: hit? */
        boat = ships[row - 1][col - 1];

        if (boat == 0) {                           /* MISS */
            shots[row - 1][col - 1] = 1;
            draw_grid();
            lcd_string(LINE2, "MISS    ");
            feedback_miss();
        } else {                                   /* HIT */
            shots[row - 1][col - 1] = 2;
            lives[boat - 1]--;
            draw_grid();

            if (lives[boat - 1] > 0) {
                lcd_string(LINE2, "HIT!    ");
                feedback_hit();
            } else {
                boats_left--;                      /* boat sunk */
                lcd_string(LINE2, "SUNK!   ");
                if (boats_left > 0) {
                    feedback_sink();
                } else {
                    // GAME OVER: all ships sunk //
                    lcd_string(LINE3, "GAMEOVER");
                    lcd_string(LINE4, "PRESS # ");
                    feedback_gameover();
                    while (get_key() != '#');
                    new_game();                    // back to SETUP //
                }
            }
        }
    }
}
