#include <hidef.h>      /* common defines and macros */
#include "derivative.h"      /* derivative-specific definitions */



#define SCI0BDH   (*(volatile unsigned char *)0x00C8)  /* baud rate high byte   */
#define SCI0BDL   (*(volatile unsigned char *)0x00C9)  /* baud rate low byte    */
#define SCI0CR1   (*(volatile unsigned char *)0x00CA)  /* control register 1    */
#define SCI0CR2   (*(volatile unsigned char *)0x00CB)  /* control register 2    */
#define SCI0SR1   (*(volatile unsigned char *)0x00CC)  /* status register 1     */
#define SCI0DRL   (*(volatile unsigned char *)0x00CF)  /* data register (byte in / byte out) */
 
/* LEDs (used to show "connected") */
#define PORTB     (*(volatile unsigned char *)0x0001)  /* the 8 LEDs            */
#define DDRB      (*(volatile unsigned char *)0x0003)  /* Port B direction      */
#define PTJ       (*(volatile unsigned char *)0x0268)  /* Port J data           */
#define DDRJ      (*(volatile unsigned char *)0x026A)  /* Port J direction      */
 
/* Bits inside SCI0SR1 */
#define TDRE      0x80     /* 1 = ready to send the next byte   */
#define RDRF      0x20     /* 1 = a byte has been received      */
 
void sci0_init(void)
{
    SCI0BDH = 0x00;        /* baud = 24 MHz / (16 * 156) = 9600 */
    SCI0BDL = 0x9C;        /* 0x9C = 156                        */
    SCI0CR1 = 0x00;        /* 8 data bits, no parity            */
    SCI0CR2 = 0x0C;        /* turn on transmitter and receiver  */
}
 
/* Send one character */
void sci0_send_char(char c)
{
    while ((SCI0SR1 & TDRE) == 0) { }   /* wait until the port is free */
    SCI0DRL = c;
}
 
/* Send a whole string, e.g. "HELLO" */
void sci0_send_string(char *s)
{
    while (*s != 0) {
        sci0_send_char(*s);
        s++;
    }
}
 
/* Has a character arrived? 1 = yes, 0 = no */
unsigned char sci0_char_ready(void)
{
    if (SCI0SR1 & RDRF) return 1;
    return 0;
}

char sci0_read_char(void)
{
    return SCI0DRL;        /* reading SR1 then DRL clears the flag */
}


char last[5];
 
void remember_char(char c)
{
    last[0] = last[1];
    last[1] = last[2];
    last[2] = last[3];
    last[3] = last[4];
    last[4] = c;
}
 
unsigned char got_HELLO(void)
{
    return (last[0] == 'H' && last[1] == 'E' && last[2] == 'L' &&
            last[3] == 'L' && last[4] == 'O');
}
 
unsigned char got_ACK(void)
{
    return (last[2] == 'A' && last[3] == 'C' && last[4] == 'K');
}
 
void comm_connect(void)
{
    unsigned char heard_hello = 0;   /* 1 = we received "HELLO" from the other board */
    unsigned char heard_ack   = 0;   /* 1 = the other board answered our HELLO       */
    unsigned int  wait;
    char c;
 
    while (heard_hello == 0 || heard_ack == 0) {

        if (heard_ack == 0) {
            sci0_send_string("HELLO");
        }

        for (wait = 0; wait < 30000; wait++) {
            if (sci0_char_ready()) {
                c = sci0_read_char();
                remember_char(c);
 
                if (got_HELLO()) {
                    heard_hello = 1;
                    sci0_send_string("ACK");   /* answer: "I heard you" */
                }
                if (got_ACK()) {
                    heard_ack = 1;             /* the other board heard us */
                }
            }
        }
    }
}
 
 
void main(void)
{
    /* LEDs: Port B as outputs, PJ1 = 0 enables the LEDs on the Dragon12 */
    DDRB  = 0xFF;
    DDRJ |= 0x02;
    PTJ  &= ~0x02;
    PORTB = 0x00;          /* LEDs off while connecting */
 
    sci0_init();
 
    comm_connect();        /* stays here until both boards have said HELLO */
 
    PORTB = 0xFF;          /* connected: all LEDs on */
 
    for (;;) { }           /* next step (board ID exchange) will go here */
}
