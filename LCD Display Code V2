#include <hidef.h>
#include "derivative.h"

#define RS_PIN   0x01     // PT0 
#define RW_PIN   0x02     // PT1 
#define E_PIN    0x04     // PT2 

void short_delay(void)
{
    int i;
    for (i = 0; i < 10; i++) {
    }
}

void delay_ms(int ms)
{
    int i, j;
    for (i = 0; i < ms; i++) {       
        for (j = 0; j < 4000; j++) {  
        }
    }
}

void send_Byte(unsigned char b){
  int i;
  for(i=0;i<8;i++){
    if (b & 0x80) {
      PTT = PTT | RW_PIN;      
    } else {
      PTT = PTT & ~RW_PIN;      
    }
    short_delay();           
   PTT = PTT | E_PIN;        
    short_delay();             
    PTT = PTT & ~E_PIN;        
    b = b << 1;                
  }
}

void send_cmd(unsigned char c){
  PTT = PTT | RS_PIN;            
  send_Byte(0xF8);             
  send_Byte(c & 0xF0);        
  send_Byte((c << 4) & 0xF0); 
  PTT = PTT & ~RS_PIN;           
  delay_ms(1);                  
}
void lcd_start(void){
  delay_ms(50);      
  send_cmd(0x30);    // ALl commands were written in the datasheet, also there is a sheet in the shared drive for the command list I created
  send_cmd(0x30);  
  send_cmd(0x0C);     
  send_cmd(0x01);   
  delay_ms(12);       
  send_cmd(0x06);     
}

void draw_grid(void){
  int y, col;
  unsigned char pixels;

  send_cmd(0x36);                         

  for (y = 0; y < 64; y++){

    if (y < 32){                         
      send_cmd(0x80 + y);
      send_cmd(0x80);
    } else {                               
      send_cmd(0x80 + (y - 32));
      send_cmd(0x88);
    }

    for (col = 0; col < 8; col++){        
      if (y % 8 == 0 || y == 63){
        pixels = 0xFF;                    
      } else {
        pixels = 0x80;                    
        if (col == 7){
          pixels = pixels | 0x01;        
        }
        if (board[y / 8][col] == 1 && y % 8 >= 2 && y % 8 <= 5){
          pixels = pixels | 0x3C;        
        }
      }
      send_data(pixels);
    }
  }

  send_cmd(0x30);                          
}


